-static void piano_mca_cp_stop(struct piano_mca *mca, const char *why)
+/* Do not trust the setter's cached state: CHG_EN can clear after a delay. */
+static int piano_mca_cp_wait_stopped(struct piano_mca *mca)
+{
+	int ret, on, tries;
+
+	for (tries = 0; tries <= 5; tries++) {
+		ret = piano_mca_cp_get(mca, POWER_SUPPLY_PROP_ONLINE, &on);
+		if (ret || !on)
+			return ret;
+		if (tries < 5)
+			msleep(100);
+	}
+	return -EBUSY;
+}
+
+static int piano_mca_cp_stop(struct piano_mca *mca, const char *why)
 {
