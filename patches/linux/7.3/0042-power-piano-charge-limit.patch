 		/* UCSI ONLINE follows the connector, not VBUS. Preserve an
 		 * authentication reset only while its cable remains connected.
@@ -2181,7 +2357,8 @@ static void piano_mca_poll(struct work_struct *work)
 			mca->mipps_attempted = false;
 		}
 		piano_mca_cp_learn_drop(mca);
-		piano_mca_cp_stop(mca, "detached");
+		if (piano_mca_cp_stop(mca, "detached"))
+			goto requeue;
 		mca->cp = MCA_CP_OFF;
 		if (mca->icl_set_ma)
 			piano_mca_reset_icl(mca);
@@ -2192,22 +2369,25 @@ static void piano_mca_poll(struct work_struct *work)
 			mca->hv_retry = jiffies + msecs_to_jiffies(MCA_HV_RETRY_MS);
 		mca->hv = MCA_HV_OFF;
 		mca->hv_renegs = 0;
+	} else if (charge_policy && paused) {
+		piano_mca_apply_policy(mca, true);
 	} else if (charge_policy && piano_mca_cp_active(mca)) {
 		piano_mca_cp_step(mca);
 	} else if (charge_policy) {
 		piano_mca_mipps_authenticate(mca);
 		piano_mca_cp_try_start(mca);
 		if (!piano_mca_cp_active(mca))
-			piano_mca_apply_policy(mca);
+			piano_mca_apply_policy(mca, false);
