+/* Read both gauges: stop when either pack reaches the upper threshold. */
+static int piano_mca_charge_soc(struct piano_mca *mca)
+{
+	union power_supply_propval val;
+	struct power_supply *psy;
+	unsigned int i;
+	int ret, soc = 0;
+
+	for (i = 0; i < ARRAY_SIZE(piano_mca_supplied_to); i++) {
+		psy = power_supply_get_by_name(piano_mca_supplied_to[i]);
+		if (!psy)
+			return -ENODEV;
+		ret = power_supply_get_property(psy, POWER_SUPPLY_PROP_CAPACITY, &val);
+		power_supply_put(psy);
+		if (ret)
+			return ret;
+		if (val.intval < 0 || val.intval > 100)
+			return -ERANGE;
+		soc = max(soc, val.intval);
+	}
+	return soc;
+}
+
+/* policy_lock serializes the poll, sysfs updates and system sleep. */
+static int piano_mca_apply_charge_limit(struct piano_mca *mca, bool input_unknown)
+{
+	unsigned int generation = READ_ONCE(mca->pdr_generation);
+	int limit = mca->charge_limit;
+	bool limited = limit < 100;
+	bool stop = limited && (READ_ONCE(mca->sleeping) || input_unknown), was_stopped;
+	bool cp_active;
+	int soc, ret, cp_ret = 0;
+	u8 enabled;
+
+	/* Until a limit is selected, preserve the existing firmware policy. */
+	if (!limited && (!mca->charge_managed ||
+			 (mca->charge_state_valid && mca->charging_enabled)))
+		return 0;
+	if (!READ_ONCE(mca->service_up))
+		return -ENODEV;
+
+	if (!mca->online || !limited) {
+		mca->limit_latched = false;
+	} else {
+		soc = piano_mca_charge_soc(mca);
+		/* An unavailable gauge must not silently allow charging past a cap. */
+		if (soc < 0)
+			stop = true;
+		else if (soc >= limit)
+			mca->limit_latched = true;
+		else if (soc <= limit - 5)
+			mca->limit_latched = false;
+		stop |= mca->limit_latched;
+	}
+
+	if (stop) {
+		cp_active = piano_mca_cp_active(mca);
+		cp_ret = piano_mca_cp_stop(mca, "charge limit");
+		if (!cp_ret && cp_active)
+			mca->limit_cp_stopped = true;
+	}
+	enabled = !stop;
+	was_stopped = mca->charge_state_valid && !mca->charging_enabled;
+	if (!mca->charge_state_valid || mca->charge_generation != generation ||
+	    mca->charging_enabled != enabled) {
+		/* A timeout can lose only the reply, not the firmware write. */
+		mca->charge_managed = true;
+		mca->charge_state_valid = false;
+		ret = piano_mca_write(mca, MCA_PROP_CHARGE_ENABLE, &enabled, sizeof(enabled));
+		if (ret)
+			return ret;
+		if (!READ_ONCE(mca->service_up) ||
+		    generation != READ_ONCE(mca->pdr_generation))
+			return -EAGAIN;
+		mca->charge_generation = generation;
+		mca->charging_enabled = enabled;
+		mca->charge_state_valid = true;
+		if (enabled && (was_stopped || mca->limit_cp_stopped) &&
+		    !piano_mca_cp_active(mca)) {
+			mca->cp = MCA_CP_OFF;
+			mca->limit_cp_stopped = false;
+		}
+		dev_info(mca->dev, "charge limit %u%%: battery charging %s\n",
+			 mca->charge_limit, enabled ? "enabled" : "stopped");
+		power_supply_changed(mca->usb);
+	}
+	return cp_ret;
+}
