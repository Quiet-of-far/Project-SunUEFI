+/* The AP policy cannot poll while asleep: pause charging before transport suspend. */
+static int piano_mca_prepare(struct device *dev)
+{
+	struct piano_mca *mca = dev_get_drvdata(dev);
+	int ret;
+
+	piano_mca_pause_poll(mca, false);
+	mutex_lock(&mca->policy_lock);
+	ret = piano_mca_apply_charge_limit(mca, false);
+	if (ret) {
+		spin_lock_irq(&mca->poll_lock);
+		mca->sleeping = false;
+		spin_unlock_irq(&mca->poll_lock);
+		piano_mca_queue_poll(mca, 0);
+	}
+	mutex_unlock(&mca->policy_lock);
+	return ret;
+}
+
+static void piano_mca_complete(struct device *dev)
+{
+	struct piano_mca *mca = dev_get_drvdata(dev);
+
+	mutex_lock(&mca->policy_lock);
