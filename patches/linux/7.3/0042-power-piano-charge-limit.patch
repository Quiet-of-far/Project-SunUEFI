+static int piano_mca_usb_set_property(struct power_supply *psy,
+				      enum power_supply_property psp,
+				      const union power_supply_propval *val)
+{
+	struct piano_mca *mca = power_supply_get_drvdata(psy);
+
+	if (psp != POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD)
+		return -EINVAL;
+	if (val->intval < 50 || val->intval > 100)
+		return -EINVAL;
+	mutex_lock(&mca->policy_lock);
+	if (READ_ONCE(mca->stopping)) {
+		mutex_unlock(&mca->policy_lock);
+		return -ENODEV;
+	}
+	WRITE_ONCE(mca->charge_limit, val->intval);
+	piano_mca_queue_poll(mca, 0);
+	mutex_unlock(&mca->policy_lock);
+	power_supply_changed(psy);
+	return 0;
+}
+
+static int piano_mca_usb_property_is_writeable(struct power_supply *psy,
