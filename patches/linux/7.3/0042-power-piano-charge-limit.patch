+/* Serialize all requeues with suspend and unbind cancellation. */
+static void piano_mca_queue_poll(struct piano_mca *mca, unsigned long delay)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&mca->poll_lock, flags);
+	if (!mca->sleeping && !mca->stopping)
+		mod_delayed_work(system_percpu_wq, &mca->poll, delay);
+	spin_unlock_irqrestore(&mca->poll_lock, flags);
+}
+
+static void piano_mca_pause_poll(struct piano_mca *mca, bool stopping)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&mca->poll_lock, flags);
+	if (stopping)
+		mca->stopping = true;
+	else
+		mca->sleeping = true;
+	spin_unlock_irqrestore(&mca->poll_lock, flags);
+	cancel_delayed_work_sync(&mca->poll);
+}
