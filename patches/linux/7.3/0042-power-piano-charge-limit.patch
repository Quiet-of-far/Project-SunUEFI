-				      msecs_to_jiffies(piano_mca_cp_active(mca) ?
-						       MCA_CP_POLL_MS : MCA_POLL_MS));
+	if (READ_ONCE(mca->service_up))
+		piano_mca_queue_poll(mca, msecs_to_jiffies(piano_mca_cp_active(mca) ?
+							MCA_CP_POLL_MS : MCA_POLL_MS));
+unlock:
+	mutex_unlock(&mca->policy_lock);
 }
 
 static enum power_supply_usb_type piano_mca_usb_type(u32 real_type)
@@ -2261,6 +2441,9 @@ static int piano_mca_usb_get_property(struct power_supply *psy,
 	case POWER_SUPPLY_PROP_USB_TYPE:
 		val->intval = piano_mca_usb_type(mca->real_type);
