 	piano_mca_stop(auxiliary_get_drvdata(adev));
 }
 
 static int piano_mca_probe(struct auxiliary_device *adev,
 			   const struct auxiliary_device_id *id)
 {
 	struct device *dev = &adev->dev;
 	struct power_supply_config psy_cfg = {};
 	struct piano_mca *mca;
 	int ret;
 
 	mca = devm_kzalloc(dev, sizeof(*mca), GFP_KERNEL);
 	if (!mca)
 		return -ENOMEM;
 
 	mca->dev = dev;
 	auxiliary_set_drvdata(adev, mca);
 	mca->pd_protocol_version = 1;
 	device_property_read_u32(dev, "xiaomi,mca-pd-protocol-version",
 				 &mca->pd_protocol_version);
 	if (mca->pd_protocol_version < 1 || mca->pd_protocol_version > 2)
 		return dev_err_probe(dev, -EINVAL, "unsupported MCA PD protocol\n");
 	dev_info(dev, "MCA PD protocol version %u\n", mca->pd_protocol_version);
 	mca->hv_retry = jiffies;
 	piano_mca_parse_otg_config(mca);
 	mutex_init(&mca->lock);
 	mutex_init(&mca->policy_lock);
 	mca->charge_limit_ua = MCA_FFC_IBAT_MAX_MA * 1000;
+	mca->charge_end_threshold = 100;
 	mutex_init(&mca->pen_boost_lock);
 	init_completion(&mca->ack);
 	INIT_DELAYED_WORK(&mca->poll, piano_mca_poll);
 	atomic_set(&mca->connection_generation, 0);
 
 	/* Allocated first so it outlives the poll work on unbind */
 	mca->client = devm_pmic_glink_client_alloc(dev, PMIC_GLINK_OWNER_BATTMGR,
 						   piano_mca_callback,
 						   piano_mca_pdr_notify, mca);
 	if (IS_ERR(mca->client))
 		return PTR_ERR(mca->client);
 
 	psy_cfg.drv_data = mca;
 	psy_cfg.supplied_to = piano_mca_supplied_to;
 	psy_cfg.num_supplicants = ARRAY_SIZE(piano_mca_supplied_to);
 	psy_cfg.attr_grp = piano_mca_usb_groups;
 	mca->usb = devm_power_supply_register(dev, &piano_mca_usb_desc, &psy_cfg);
 	if (IS_ERR(mca->usb))
 		return PTR_ERR(mca->usb);
 
 	ret = piano_mca_register_cooling(mca);
 	if (ret)
 		return dev_err_probe(dev, ret, "failed to register charger cooling\n");
 	ret = piano_mca_register_skin(mca);
 	if (ret)
 		return dev_err_probe(dev, ret, "failed to register skin temperature\n");
 	/* Stop before devres releases temperatures, cooling and power supply. */
 	ret = devm_add_action_or_reset(dev, piano_mca_stop, mca);
 	if (ret)
 		return ret;
 
 	ret = piano_mca_register_pen_supply(mca);
 	if (ret)
 		return ret;
 
 	mca->dbg = debugfs_create_dir("piano_mca", NULL);
 	debugfs_create_file("prop", 0200, mca->dbg, mca, &piano_mca_dbg_prop_fops);
 	debugfs_create_file("data", 0400, mca->dbg, mca, &piano_mca_dbg_data_fops);
 	debugfs_create_file("summary", 0400, mca->dbg, mca,
 			    &piano_mca_dbg_summary_fops);
 	devm_add_action_or_reset(dev, piano_mca_dbg_remove, mca->dbg);
 
 	/* Resources are ready; unregister before the earlier poll-stop action. */
 	mca->connection_notifier.notifier_call = piano_mca_connection_changed;
 	ret = power_supply_reg_notifier(&mca->connection_notifier);
 	if (ret)
 		return ret;
 	ret = devm_add_action_or_reset(dev, piano_mca_unregister_connection_notifier,
 				       mca);
 	if (ret)
 		return ret;
 
 	mutex_lock(&mca->policy_lock);
 	mca->policy_ready = true;
 	mutex_unlock(&mca->policy_lock);
 	pmic_glink_client_register(mca->client);
 
 	if (pan_ack)
 		return piano_mca_pan_init(mca);
 	return 0;
 }
 
