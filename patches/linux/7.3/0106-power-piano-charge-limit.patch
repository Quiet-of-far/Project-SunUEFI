 static int piano_mca_update_skin(struct piano_mca *mca);
 static u32 piano_mca_skin_buck_current(struct piano_mca *mca);
 
 /* Skin, the cooling device and power-supply limit share one total budget. */
 static u32 piano_mca_charge_limit(struct piano_mca *mca)
 {
 	u32 ua = READ_ONCE(mca->charge_limit_ua);
 
 	if (mca->cooling_count)
 		ua = min(ua, mca->cooling_limits_ua[READ_ONCE(mca->cooling_state)]);
 	if (mca->skin_control)
 		ua = min(ua, READ_ONCE(mca->skin_limit_ma) * 1000);
 	return ua / 1000;
 }
 
+/* The capacity cap shares the normal policy's confirmed stop/restart path. */
+static bool piano_mca_charge_inhibited(struct piano_mca *mca)
+{
+	return READ_ONCE(mca->inhibit_charge) || mca->end_paused;
+}
+
 static unsigned int piano_mca_connection_generation(struct piano_mca *mca)
 {
 	return atomic_read(&mca->connection_generation);
 }
 
 static int piano_mca_connection_changed(struct notifier_block *nb,
 					unsigned long event, void *data)
 {
 	struct piano_mca *mca = container_of(nb, struct piano_mca,
 						connection_notifier);
 	struct power_supply *psy = data;
 	struct device *parent = psy->dev.parent;
 
 	if (event != PSY_EVENT_CONNECTION_CHANGED ||
 	    !parent || parent->parent != mca->dev->parent ||
 	    psy->desc->type != POWER_SUPPLY_TYPE_USB ||
 	    !str_has_prefix(psy->desc->name, "ucsi-source-psy-"))
 		return NOTIFY_DONE;
 
 	/* Preserve physical changes even while the worker waits for an answer. */
 	atomic_inc(&mca->connection_generation);
 	mod_delayed_work(system_freezable_wq, &mca->poll, 0);
 	return NOTIFY_OK;
 }
 
 static void piano_mca_unregister_connection_notifier(void *data)
 {
 	struct piano_mca *mca = data;
 
 	power_supply_unreg_notifier(&mca->connection_notifier);
 }
 
 static bool piano_mca_session_valid(struct piano_mca *mca,
 				    unsigned int generation,
 				    unsigned int connection)
 {
 	return generation == pmic_glink_get_generation(mca->client) &&
 	       connection == piano_mca_connection_generation(mca);
 }
 
 static bool piano_mca_authenticated(struct piano_mca *mca)
 {
 	return mca->auth_ok && !mca->mipps_cleanup_pending &&
 	       piano_mca_session_valid(mca, mca->auth_generation,
 				       mca->mipps_connection_generation);
 }
 
 static void piano_mca_callback(const void *data, size_t len, void *priv)
 {
 	struct piano_mca *mca = priv;
 	const struct mca_resp *resp = data;
 
 	if (le32_to_cpu(resp->type) == PMIC_GLINK_NOTIFY) {
 		/* notification: id at +0xc, payload from +0x10 */
 		dev_dbg(mca->dev, "notify %#x len %zu\n",
 			le32_to_cpu(resp->property), len);
 		mod_delayed_work(system_freezable_wq, &mca->poll, 0);
 		return;
 	}
 
 	if (len != sizeof(*resp)) {
 		dev_warn(mca->dev, "unexpected response length %zu\n", len);
 		return;
 	}
 
 	if (le32_to_cpu(resp->seq) != mca->seq) {
 		dev_dbg(mca->dev, "stale response seq %u != %u\n",
 			le32_to_cpu(resp->seq), mca->seq);
 		return;
 	}
@@ -2146,141 +2154,141 @@ static int piano_mca_battery_state(struct piano_mca *mca)
 	if (soc < 0 || soc > 10000)
 		return -ENODATA;
 	mca->battery_soc = soc / 100;
 	/* The final same-device smart_charge cc_ichg_cfg, not ut_test. */
 	mca->battery_fcc_derate_ma = mca->battery_cycles <= 800 ? 100 : 200;
 	/* Active Piano BAA_config_final CN-battery, not the DT's ut_test table. */
 	mca->battery_fv_derate_mv = mca->battery_cycles <= 100 ? 0 :
 		mca->battery_cycles <= 300 ? 20 : mca->battery_cycles < 1000 ? 40 : 50;
 	mca->battery_normal_fv_derate_mv = mca->battery_cycles <= 100 ? 0 :
 		mca->battery_cycles <= 300 ? 10 : mca->battery_cycles < 1000 ? 20 : 30;
 	mca->battery_health_fv_derate_mv = mca->battery_cycles >= 200 &&
 		mca->battery_cycles <= 800 && soh < 85 ? 40 : 0;
 	mca->battery_authentic = true;
 	return 0;
 }
 
 /* No raised PMIC voltage is retained across a partial gauge-mode update. */
 static int piano_mca_set_gauge_modes(struct piano_mca *mca, bool fast)
 {
 	union power_supply_propval value = {
 		.intval = fast ? POWER_SUPPLY_CHARGE_TYPE_FAST :
 				POWER_SUPPLY_CHARGE_TYPE_STANDARD,
 	};
 	struct power_supply *psy;
 	int i, ret = 0, error;
 
 	for (i = 0; i < ARRAY_SIZE(piano_mca_supplied_to); i++) {
 		psy = power_supply_get_by_name(piano_mca_supplied_to[i]);
 		if (!psy) {
 			ret = ret ?: -ENODEV;
 			continue;
 		}
 		error = power_supply_set_property(psy, POWER_SUPPLY_PROP_CHARGE_TYPE, &value);
 		power_supply_put(psy);
 		ret = ret ?: error;
 	}
 	return ret;
 }
 
 static int piano_mca_set_ffc(struct piano_mca *mca, bool fast)
 {
 	int ret;
 
 	mca->ffc_mode_known = false;
 	ret = piano_mca_set_gauge_modes(mca, fast);
 	if (ret) {
 		/* Either gauge may have accepted a command whose reply was lost. */
 		if (fast && !piano_mca_set_gauge_modes(mca, false)) {
 			mca->ffc = false;
 			mca->ffc_mode_known = true;
 		}
 		return ret;
 	}
 	if (mca->ffc != fast) {
 		mca->cp_profile = 0;
 		mca->buck_cv_steps = 0;
 		dev_info(mca->dev, "%s battery charging mode\n", fast ? "FFC" : "standard");
 	}
 	mca->ffc = fast;
 	mca->ffc_mode_known = true;
 	return 0;
 }
 
 static int piano_mca_update_ffc(struct piano_mca *mca, int tcool, int twarm)
 {
 	bool fast;
 	int ret;
 
 	ret = piano_mca_battery_state(mca);
 	fast = !ret && !mca->ffc_done && !mca->normal_full && mca->online &&
-	       !READ_ONCE(mca->inhibit_charge) && piano_mca_charge_limit(mca) &&
+	       !piano_mca_charge_inhibited(mca) && piano_mca_charge_limit(mca) &&
 	       mca->skin_control && !mca->skin_error &&
 	       time_before_eq(jiffies, mca->skin_sample_at +
 			      msecs_to_jiffies(2 * MCA_SKIN_POLL_MS)) &&
 	       tcool >= MCA_FFC_TEMP_MIN && twarm < MCA_FFC_TEMP_MAX &&
 	       !mca->normal_warm && piano_mca_adapter_verified(mca) &&
 	       (mca->ffc || mca->battery_soc < MCA_FFC_SOC_MAX);
 	if (mca->ffc == fast && mca->ffc_mode_known)
 		return 0;
 	/* A live pump must be stopped before either gauge changes mode. */
 	if (piano_mca_cp_active(mca))
 		return -EAGAIN;
 	ret = piano_mca_normal_pause(mca, pmic_glink_get_generation(mca->client),
 				      piano_mca_connection_generation(mca));
 	if (ret)
 		return ret;
 	return piano_mca_set_ffc(mca, fast);
 }
 
 static int piano_mca_cp_temp_profile(int temp)
 {
 	int i;
 
 	for (i = 0; i < ARRAY_SIZE(piano_mca_cp_profiles); i++)
 		if (temp >= piano_mca_cp_profiles[i].low &&
 		    temp < piano_mca_cp_profiles[i].high)
 			return i;
 	return -ERANGE;
 }
 
 /* Tighten immediately; require temperature headroom before restoring FV. */
 static void piano_mca_normal_temperature(struct piano_mca *mca, int tcool,
 					 int twarm)
 {
 	if (tcool < -9)
 		mca->normal_cold = true;
 	else if (tcool >= -8)
 		mca->normal_cold = false;
 	if (twarm >= 55)
 		mca->cp_hot = true;
 	else if (twarm < 53)
 		mca->cp_hot = false;
 	if (twarm >= 48)
 		mca->normal_warm = true;
 	else if (twarm < 46)
 		mca->normal_warm = false;
 }
 
 /*
  * Evaluate the CN normal tables against both cells and the firmware pack.
  * The colder/hotter cell may request different profiles: use the lower FV
  * and both current limits. This extra per-cell check is local protection.
  * CC/CV stages advance within a temperature pair, including across suspend.
  */
 static int piano_mca_cp_normal_limits(struct piano_mca *mca, int vbat, int ibat,
 				      int tcool, int twarm,
 				      struct piano_mca_cp_limits *limits)
 {
 	const struct piano_mca_cp_profile *cold, *hot, *profile;
 	const struct piano_mca_cp_voltage *voltage;
 	struct piano_mca_cp_profile aged;
 	u32 key, ma, ceiling = MCA_CP_IBAT_MAX_MA;
 	int a, b, stage, last;
 
 	piano_mca_normal_temperature(mca, tcool, twarm);
 	if (tcool < 8)
 		mca->cp_cold = true;
 	if (twarm >= 55)
 		mca->cp_hot = true;
 	/* Factory restart hysteresis after leaving the charging window. */
 	if ((mca->cp_cold && tcool <= 8) || mca->cp_hot)
@@ -2331,141 +2339,141 @@ static int piano_mca_cp_normal_limits(struct piano_mca *mca, int vbat, int ibat,
 				aged.voltage[1].max_ma = 5786;
 			}
 		}
 		aged.fv_mv -= mca->battery_health_fv_derate_mv;
 		aged.voltage[last].mv -= mca->battery_health_fv_derate_mv;
 		profile = &aged;
 	}
 	key = a * ARRAY_SIZE(piano_mca_cp_profiles) + b + 1 + (mca->ffc ? 32 : 0);
 	if (key != mca->cp_profile) {
 		mca->cp_profile = key;
 		mca->cp_stage = 0;
 		mca->cp_taper_at = 0;
 	}
 	ma = min3(clamp(cp_ibat_max, 1000U, ceiling),
 		  (u32)cold->voltage[0].max_ma, (u32)hot->voltage[0].max_ma);
 	stage = min_t(u32, mca->cp_stage / 2, profile->count - 1);
 	voltage = &profile->voltage[stage];
 	/* The factory FFC stage mask skips the CV phase at 4144 mV. */
 	if (mca->ffc && !stage && vbat >= voltage->mv) {
 		stage = 1;
 		mca->cp_stage = 2;
 		voltage = &profile->voltage[stage];
 	}
 	if (vbat >= voltage->mv) {
 		if (ibat <= min_t(int, voltage->min_ma, ma) &&
 		    stage + 1 < profile->count) {
 			stage++;
 			mca->cp_stage = 2 * stage;
 			voltage = &profile->voltage[stage];
 		} else {
 			mca->cp_stage = max_t(u32, mca->cp_stage, 2 * stage + 1);
 		}
 	}
 	ma = min(ma, (u32)voltage->max_ma);
 	if (mca->ffc)
 		ma -= min(ma, mca->battery_fcc_derate_ma);
 	else if (!mca->battery_authentic)
 		ma = min(ma, 2000U);
 	limits->ma = min(ma, piano_mca_charge_limit(mca));
 	limits->last = stage + 1 == profile->count;
 	limits->cv_mv = voltage->mv - (limits->last ? MCA_CP_TAPER_DELTA_MV : 0);
 	limits->fv_mv = profile->fv_mv;
 	limits->iterm_ma = mca->ffc ? profile->voltage[profile->count - 1].min_ma +
 					     (twarm >= 35 ? 68 : 75) : MCA_NORMAL_ITERM_MA;
 	if (vbat >= limits->cv_mv)
 		mca->cp_stage = max_t(u32, mca->cp_stage, 2 * stage + 1);
 	return 0;
 }
 
 /* Factory low-FV JEITA vote, independent of the temperature-stop vote. */
 static bool piano_mca_normal_voltage_stop(struct piano_mca *mca, int vbat, int fv)
 {
 	if (fv > MCA_NORMAL_LOW_FV_MAX_MV)
 		mca->normal_voltage_stop = false;
 	else if (vbat >= fv - MCA_NORMAL_HOT_TERM_HYS_MV)
 		mca->normal_voltage_stop = true;
 	else if (vbat < fv - MCA_NORMAL_HOT_RECHARGE_MV)
 		mca->normal_voltage_stop = false;
 
 	return mca->normal_voltage_stop;
 }
 
 /* The enable getter really reads PMIC CHGR 0x2646 bit 0, unlike FCC/ITERM. */
 static int piano_mca_normal_enable(struct piano_mca *mca, bool enable,
 				   unsigned int generation,
 				   unsigned int connection)
 {
 	u8 requested = enable, actual;
 	int ret;
 
-	if (enable && (READ_ONCE(mca->inhibit_charge) || mca->normal_full))
+	if (enable && (piano_mca_charge_inhibited(mca) || mca->normal_full))
 		return -EPERM;
 
 	ret = piano_mca_xfer(mca, MCA_OP_READ, MCA_PROP_CHARGE_ENABLE,
 			     &actual, sizeof(actual), generation, connection);
 	/* An unreadable charger may still be stopped, but must not be enabled. */
 	if (ret && enable)
 		return ret;
 	/* The getter covers CHG_EN only; the setter also configures DCDC modes. */
 	ret = piano_mca_write_session(mca, MCA_PROP_CHARGE_ENABLE,
 				      &requested, sizeof(requested),
 				      generation, connection);
 	ret = ret ?: piano_mca_xfer(mca, MCA_OP_READ, MCA_PROP_CHARGE_ENABLE,
 				    &actual, sizeof(actual), generation, connection);
 	if (ret)
 		return ret;
 	return actual == requested ? 0 : -EIO;
 }
 
 /*
  * Use the stock setters' ACKs. FCC and ITERM reads are firmware no-ops;
  * the model-0x56 FV getter also uses twice the setter's register scale.
  */
 static int piano_mca_normal_set_fv(struct piano_mca *mca, u32 mv, u32 iterm_ma,
 				   unsigned int generation,
 				   unsigned int connection)
 {
 	int ret;
 
 	if (!piano_mca_session_valid(mca, generation, connection))
 		return -ENODEV;
 	if (mca->fv_set_mv == mv && mca->iterm_set_ma == iterm_ma &&
 	    mca->fv_generation == generation &&
 	    mca->fv_connection == connection)
 		return 0;
 	/* A lost ACK can still have applied the write: discard the old cache. */
 	mca->fv_set_mv = 0;
 	ret = piano_mca_write_u32_session(mca, MCA_PROP_FV, mv, generation, connection);
 	if (ret)
 		return ret;
 	if (!piano_mca_session_valid(mca, generation, connection))
 		return -ENODEV;
 	/* The real Piano proxy uses a four-byte mA value, with no enable bit. */
 	ret = piano_mca_write_u32_session(mca, MCA_PROP_ITERM, iterm_ma,
 					  generation, connection);
 	if (ret)
 		return ret;
 	if (!piano_mca_session_valid(mca, generation, connection))
 		return -ENODEV;
