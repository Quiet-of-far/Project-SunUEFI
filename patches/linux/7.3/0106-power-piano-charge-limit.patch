 static int piano_mca_cooling_set_cur(struct thermal_cooling_device *cdev,
 				     unsigned long state)
 {
 	struct piano_mca *mca = cdev->devdata;
 	u32 old_ma;
 
 	if (state >= mca->cooling_count)
 		return -EINVAL;
 	guard(mutex)(&mca->policy_lock);
