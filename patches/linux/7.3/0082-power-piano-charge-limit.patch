 /*
  * Stock buck strategy input current limits (mA) at 9 V: in_pd, and in_pps
  * for the two types the stock table names PD_PPS
  */
 static u32 piano_mca_hv_icl(u32 real_type)
 {
 	return real_type == MCA_TYPE_PD ? 1600 : MCA_ICL_HV_MAX_MA;
 }
 
 /*
  * charge_policy: raise the input current limit to what the detected charger
  * type allows, never above what a PD source advertises at the voltage in
  * use.  It does not follow the battery temperature (charge_current does), so
  * a warm battery is not left to carry the system. The ADSP's AICL still
  * backs the limit off if the source sags.
  */
 static int piano_mca_normal_buck(struct piano_mca *mca, int *tbat,
 				 unsigned int generation,
 				 unsigned int connection);
 
 static void piano_mca_apply_policy(struct piano_mca *mca, unsigned int generation,
 				   unsigned int connection)
 {
 	u32 target = piano_mca_policy_icl(mca->real_type);
 	u32 hv_ma;
 	__le32 pack;
 	int tbat, ret;
 
 	/* Keep sampled source capabilities tied to the poll's original session. */
 	if (!piano_mca_session_valid(mca, generation, connection))
 		return;
 
 	/* Keep the PMIC's tail-charge voltage in the current normal profile. */
-	if (cp_charge && charge_current) {
+	if (!mca->limit_paused &&
+	    ((cp_charge && charge_current) || mca->charge_managed)) {
 		if (piano_mca_normal_buck(mca, &tbat, generation, connection))
 			return;
 	} else {
 		ret = piano_mca_xfer(mca, MCA_OP_READ, MCA_PROP_PACK_TBAT,
 				      &pack, sizeof(pack), generation, connection);
 		if (ret)
 			return;
 		tbat = (s32)le32_to_cpu(pack);
-		if (charge_current)
+		if (charge_current && !mca->limit_paused)
 			piano_mca_apply_fcc(mca, tbat, generation, connection);
 	}
 
 	hv_ma = piano_mca_hv_step(mca, generation, connection);
 	if (hv_ma)
 		target = clamp(hv_ma, MCA_ICL_MIN_MA,
 			       piano_mca_hv_icl(mca->real_type));
 	else if (piano_mca_is_pd(mca->real_type))
 		target = clamp(piano_mca_pd_5v_ma(mca, generation, connection),
 			       MCA_ICL_MIN_MA, target);
 
 	if (target == mca->icl_set_ma)
 		return;
 
 	ret = piano_mca_write_u32_session(mca, MCA_PROP_ICL, target,
 					  generation, connection);
 	if (ret) {
 		dev_warn(mca->dev, "failed to set input limit %u mA: %d\n",
 			 target, ret);
 		return;
 	}
 
 	dev_info(mca->dev, "%s: input limit %u mA at %s (battery %d degC)\n",
 		 piano_mca_type_name(mca->real_type) ?: "Unknown", target,
 		 hv_ma ? "9 V" : "5 V", tbat);
 	mca->icl_set_ma = target;
 }
 
 static char *piano_mca_supplied_to[] = { "bq27z561-0", "bq27z561-1" };
 
 /*
  * Both fuel gauges: the higher cell voltage (mV), the sum of the currents
  * (mA, positive while charging), and both temperature extremes (degC).
  */
 static int piano_mca_gauges(int *vbat_mv, int *ibat_ma, int *tcool, int *twarm)
 {
 	union power_supply_propval v, i, t;
 	struct power_supply *psy;
 	int n, ret;
 
 	*vbat_mv = 0;
 	*ibat_ma = 0;
 	*tcool = INT_MAX;
 	*twarm = INT_MIN;
 	for (n = 0; n < ARRAY_SIZE(piano_mca_supplied_to); n++) {
 		psy = power_supply_get_by_name(piano_mca_supplied_to[n]);
 		if (!psy)
 			return -ENODEV;
 		ret = power_supply_get_property(psy, POWER_SUPPLY_PROP_VOLTAGE_NOW, &v);
 		ret = ret ?: power_supply_get_property(psy, POWER_SUPPLY_PROP_CURRENT_NOW, &i);
 		ret = ret ?: power_supply_get_property(psy, POWER_SUPPLY_PROP_TEMP, &t);
 		power_supply_put(psy);
 		if (ret)
 			return ret;
 		*vbat_mv = max(*vbat_mv, v.intval / 1000);
 		*ibat_ma += i.intval / 1000;
 		*tcool = min(*tcool, t.intval / 10);
 		*twarm = max(*twarm, t.intval / 10);
 	}
 
@@ -1959,120 +1964,123 @@ static int piano_mca_cp_normal_limits(struct piano_mca *mca, int vbat, int ibat,
 {
 	const struct piano_mca_cp_profile *cold, *hot, *profile;
 	const struct piano_mca_cp_voltage *voltage;
 	u32 key, ma;
 	int a, b, stage;
 
 	piano_mca_normal_temperature(mca, tcool, twarm);
 	if (tcool < 8)
 		mca->cp_cold = true;
 	if (twarm >= 55)
 		mca->cp_hot = true;
 	/* Factory restart hysteresis after leaving the charging window. */
 	if ((mca->cp_cold && tcool <= 8) || mca->cp_hot)
 		return -ERANGE;
 	a = piano_mca_cp_temp_profile(tcool);
 	b = piano_mca_cp_temp_profile(mca->normal_warm ? max(twarm, 48) : twarm);
 	if (a < 0 || b < 0)
 		return -ERANGE;
 	mca->cp_cold = false;
 	mca->cp_hot = false;
 	cold = &piano_mca_cp_profiles[a];
 	hot = &piano_mca_cp_profiles[b];
 	profile = cold->fv_mv < hot->fv_mv ? cold : hot;
 	key = a * ARRAY_SIZE(piano_mca_cp_profiles) + b + 1;
 	if (key != mca->cp_profile) {
 		mca->cp_profile = key;
 		mca->cp_stage = 0;
 		mca->cp_taper_at = 0;
 	}
 	ma = min3(clamp(cp_ibat_max, 1000U, (u32)MCA_CP_IBAT_MAX_MA),
 		  (u32)cold->voltage[0].max_ma, (u32)hot->voltage[0].max_ma);
 	stage = min_t(u32, mca->cp_stage / 2, profile->count - 1);
 	voltage = &profile->voltage[stage];
 	if (vbat >= voltage->mv) {
 		if (ibat <= min_t(int, voltage->min_ma, ma) &&
 		    stage + 1 < profile->count) {
 			stage++;
 			mca->cp_stage = 2 * stage;
 			voltage = &profile->voltage[stage];
 		} else {
 			mca->cp_stage = max_t(u32, mca->cp_stage, 2 * stage + 1);
 		}
 	}
 	limits->ma = min_t(u32, ma, voltage->max_ma);
 	limits->last = stage + 1 == profile->count;
 	limits->cv_mv = voltage->mv - (limits->last ? MCA_CP_TAPER_DELTA_MV : 0);
 	limits->fv_mv = profile->fv_mv;
 	if (vbat >= limits->cv_mv)
 		mca->cp_stage = max_t(u32, mca->cp_stage, 2 * stage + 1);
 	return 0;
 }
 
 /* The enable getter really reads PMIC CHGR 0x2646 bit 0, unlike FCC/ITERM. */
 static int piano_mca_normal_enable(struct piano_mca *mca, bool enable,
 				   unsigned int generation,
 				   unsigned int connection)
 {
 	u8 requested = enable, actual;
 	int ret;
 
+	if (enable && mca->limit_paused)
+		return -EBUSY;
+
 	ret = piano_mca_xfer(mca, MCA_OP_READ, MCA_PROP_CHARGE_ENABLE,
 			     &actual, sizeof(actual), generation, connection);
 	if (!ret && actual == requested)
 		return 0;
 	/* An unreadable charger may still be stopped, but must not be enabled. */
 	if (ret && enable)
 		return ret;
 	ret = piano_mca_write_session(mca, MCA_PROP_CHARGE_ENABLE,
 				      &requested, sizeof(requested),
 				      generation, connection);
 	ret = ret ?: piano_mca_xfer(mca, MCA_OP_READ, MCA_PROP_CHARGE_ENABLE,
 				    &actual, sizeof(actual), generation, connection);
 	if (ret)
 		return ret;
 	return actual == requested ? 0 : -EIO;
 }
 
 /*
  * Use the stock setters' ACKs. FCC and ITERM reads are firmware no-ops;
  * the model-0x56 FV getter also uses twice the setter's register scale.
  */
 static int piano_mca_normal_set_fv(struct piano_mca *mca, u32 mv,
 				   unsigned int generation,
 				   unsigned int connection)
 {
 	int ret;
 
 	if (!piano_mca_session_valid(mca, generation, connection))
 		return -ENODEV;
 	if (mca->fv_set_mv == mv && mca->fv_generation == generation &&
 	    mca->fv_connection == connection)
 		return 0;
 	/* A lost ACK can still have applied the write: discard the old cache. */
 	mca->fv_set_mv = 0;
 	ret = piano_mca_write_u32_session(mca, MCA_PROP_FV, mv, generation, connection);
 	if (ret)
 		return ret;
 	if (!piano_mca_session_valid(mca, generation, connection))
 		return -ENODEV;
 	/* The real Piano proxy uses a four-byte mA value, with no enable bit. */
 	ret = piano_mca_write_u32_session(mca, MCA_PROP_ITERM, MCA_NORMAL_ITERM_MA,
 					  generation, connection);
 	if (ret)
 		return ret;
 	if (!piano_mca_session_valid(mca, generation, connection))
 		return -ENODEV;
 	if (mca->fv_generation != generation || mca->fv_connection != connection)
 		mca->fcc_set_ma = 0;
 	mca->fv_set_mv = mv;
 	mca->fv_generation = generation;
 	mca->fv_connection = connection;
 	return 0;
 }
 
 static int piano_mca_normal_pause(struct piano_mca *mca,
 				  unsigned int generation,
 				  unsigned int connection)
 {
 	int ret, fcc_ret;
 
@@ -2639,336 +2647,450 @@ static void piano_mca_cp_step(struct piano_mca *mca)
 		 */
 		target = min(target, (ibat_max - (int)mca->fcc_set_ma) / 2);
 
 		over = ibus - target;
 		if (vbat >= limits.cv_mv)
 			mv -= MCA_CP_REG_STEP_MV;
 		else if (over > 0)
 			mv -= clamp(over / MCA_CP_REG_STEP_MA * MCA_CP_REG_STEP_MV,
 				    MCA_CP_REG_STEP_MV, MCA_CP_REG_MAX_STEP_MV);
 		else if (ibat > ibat_max && mca->cp_ibat_trip <= ibat_max)
 			mv -= MCA_CP_REG_STEP_MV;
 		else if (ibus + MCA_CP_BAND_MA < target &&
 			 ibat + MCA_CP_BAND_MA < ibat_max)
 			mv += MCA_CP_REG_STEP_MV;
 		/* the gauges catch up with a lowered limit only from here */
 		if (over > MCA_CP_BAND_MA)
 			mca->cp_trip_at = jiffies;
 
 		if (++mca->cp_polls % MCA_CP_LOG_POLLS == 0)
 			dev_info(mca->dev, "direct charging at %u mV: bus %d mV %d/%d mA, battery %d mV %d/%d mA %d degC, stage %d.%d degC\n",
 				 mca->cp_mv, vbus_uv / 1000, ibus, target,
 				 vbat, ibat, ibat_max, twarm,
 				 tdie / 10, tdie % 10);
 	}
 
 	mv = clamp_t(u32, mv, 2 * vbat, 2 * vbat + MCA_CP_REQ_MAX_DELTA_MV);
 	if (piano_mca_cp_request(mca, mv)) {
 		piano_mca_cp_learn_drop(mca);
 		piano_mca_cp_stop(mca, "request refused");
 	}
 }
 
 static int piano_mca_sync_connection(struct piano_mca *mca)
 {
 	unsigned int connection = piano_mca_connection_generation(mca);
 	int ret;
 
 	if (mca->polled_connection_generation == connection)
 		return 0;
 
 	/* VBUS may already be back: discard policy learned from the old source. */
 	mca->auth_ok = false;
 	if (mca->mipps_attempted)
 		mca->mipps_cleanup_pending = true;
 	mca->mipps_attempted = false;
 	mca->auth_tried = false;
 	ret = piano_mca_cp_stop(mca, "connection changed");
 	if (ret)
 		return ret;
 	mca->cp = MCA_CP_OFF;
 	mca->cp_profile = 0;
 	mca->cp_thermal_stop = false;
 	mca->cp_ibus_cap = 0;
 	mca->hv = MCA_HV_OFF;
 	mca->hv_renegs = 0;
 	mca->online = false;
 	mca->polled_connection_generation = connection;
 	return 0;
 }
 
+/* Stop when either cell reaches the cap; restart only when both are below it. */
+static int piano_mca_charge_soc(struct piano_mca *mca)
+{
+	union power_supply_propval val;
+	struct power_supply *psy;
+	unsigned int i;
+	int ret, soc = 0;
+
+	for (i = 0; i < ARRAY_SIZE(piano_mca_supplied_to); i++) {
+		psy = power_supply_get_by_name(piano_mca_supplied_to[i]);
+		if (!psy)
+			return -ENODEV;
+		ret = power_supply_get_property(psy, POWER_SUPPLY_PROP_CAPACITY, &val);
+		power_supply_put(psy);
+		if (ret)
+			return ret;
+		if (val.intval < 0 || val.intval > 100)
+			return -ERANGE;
+		soc = max(soc, val.intval);
+	}
+	return soc;
+}
+
+/* policy_lock serializes the cap with the worker, sysfs and system sleep. */
+static int piano_mca_apply_charge_limit(struct piano_mca *mca, bool input_unknown)
+{
+	unsigned int generation = pmic_glink_get_generation(mca->client);
+	unsigned int connection = piano_mca_connection_generation(mca);
+	bool was_paused = mca->limit_paused;
+	bool stop = false;
+	int soc, ret, cp_ret;
+
+	if (mca->charge_limit < 100) {
+		mca->charge_managed = true;
+		soc = piano_mca_charge_soc(mca);
+		if (soc >= (int)mca->charge_limit)
+			mca->limit_latched = true;
+		else if (soc >= 0 && soc <= (int)mca->charge_limit - 5)
+			mca->limit_latched = false;
+		stop = soc < 0 || input_unknown || mca->sleeping || mca->limit_latched;
+	} else {
+		mca->limit_latched = false;
+	}
+	mca->limit_paused = stop;
+	if (!stop) {
+		/* Normal JEITA/FV/FCC setup, not this cap, owns re-enabling charge. */
+		if (was_paused && !piano_mca_cp_active(mca))
+			mca->cp = MCA_CP_OFF;
+		return 0;
+	}
+
+	cp_ret = piano_mca_cp_stop(mca, "charge limit");
+	/* Attempt both controls even if stopping the pump fails. */
+	ret = piano_mca_normal_pause(mca, generation, connection);
+	return cp_ret ?: ret;
+}
+
 static void piano_mca_poll(struct work_struct *work)
 {
 	struct piano_mca *mca = container_of(work, struct piano_mca, poll.work);
-	bool online, changed;
+	bool online, changed, type_failed = false;
+	__le32 voltage;
+	int ret;
 	u32 real_type = MCA_TYPE_UNKNOWN;
 	unsigned int generation = pmic_glink_get_generation(mca->client);
 
+	mutex_lock(&mca->policy_lock);
+	if (mca->sleeping || mca->stopping)
+		goto unlock;
+	if (piano_mca_apply_charge_limit(mca, false))
+		goto requeue;
+
 	if (piano_mca_sync_connection(mca))
 		goto requeue;
 	/* A rapid ADSP restart must not carry the old APDO into its new session. */
 	if (piano_mca_cp_active(mca) &&
 	    (!piano_mca_cp_session_valid(mca) || mca->cp == MCA_CP_STOPPING)) {
 		if (piano_mca_cp_stop(mca, "session changed"))
 			goto requeue;
 		mca->cp = MCA_CP_OFF;
 	}
 	/* Finish an uncertain VERIFY_PROCESS write before any charging policy. */
 	if (piano_mca_mipps_cleanup(mca))
 		goto requeue;
 
 	piano_mca_sync_otg_config(mca);
-	mca->vbus_uv = piano_mca_read_u32(mca, MCA_PROP_BUS_VOLT);
+	ret = piano_mca_read(mca, MCA_PROP_BUS_VOLT, &voltage, sizeof(voltage));
+	if (ret) {
+		piano_mca_apply_charge_limit(mca, true);
