@@ -1761,130 +1765,131 @@ static u32 piano_mca_hv_step(struct piano_mca *mca, unsigned int generation,
 		}
 		if (ma && ++mca->hv_polls < MCA_HV_SETTLE_POLLS)
 			return 0;
 		break;
 	case MCA_HV_ON:
 		if (ma && vbus_hv)
 			return ma;
